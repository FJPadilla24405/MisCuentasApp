<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Panel de registro (lo usa AuthScreen.fxml con fx:include) -->
<VBox spacing="16.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RegistroController">
   <children>
      <Label styleClass="panel-titulo" text="Haz espacio para tus planes." wrapText="true" />

      <VBox spacing="6.0">
         <children>
            <Label styleClass="campo-etiqueta" text="Nombre de usuario" />
            <HBox fx:id="cajaUsuario" alignment="CENTER_LEFT" spacing="8.0" styleClass="campo-caja">
               <children>
                  <TextField fx:id="txtUsuario" onAction="#registrar" promptText="Cómo quieres que te llamemos" styleClass="campo-input" HBox.hgrow="ALWAYS" />
                  <Group>
                     <children>
                        <SVGPath content="M20 21 V19 A4 4 0 0 0 16 15 H8 A4 4 0 0 0 4 19 V21 M12 3 A4 4 0 1 0 12 11 A4 4 0 1 0 12 3 Z" scaleX="0.75" scaleY="0.75" styleClass="icono" />
                     </children>
                  </Group>
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox spacing="6.0">
         <children>
            <Label styleClass="campo-etiqueta" text="Email" />
            <HBox fx:id="cajaEmail" alignment="CENTER_LEFT" spacing="8.0" styleClass="campo-caja">
               <children>
                  <TextField fx:id="txtEmail" onAction="#registrar" promptText="tucorreo@email.com" styleClass="campo-input" HBox.hgrow="ALWAYS" />
                  <Group>
                     <children>
                        <SVGPath content="M4 4 H20 A2 2 0 0 1 22 6 V18 A2 2 0 0 1 20 20 H4 A2 2 0 0 1 2 18 V6 A2 2 0 0 1 4 4 Z M22 6 L12 13 L2 6" scaleX="0.75" scaleY="0.75" styleClass="icono" />
                     </children>
                  </Group>
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox spacing="6.0">
         <children>
            <CheckBox fx:id="chkSoloLocal" mnemonicParsing="false" text="Cuenta offline: solo en este equipo, sin sincronizar con la nube" />
            <Label fx:id="lblSoloLocal" managed="false" styleClass="texto-suave-pequeno" text="Tus datos solo se guardarán en este equipo: no se sincronizan y, si lo pierdes o olvidas la contraseña, no se pueden recuperar." visible="false" wrapText="true" />
         </children>
      </VBox>

      <VBox spacing="8.0">
         <children>
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="campo-etiqueta" text="Contraseña" />
                  <HBox fx:id="cajaPassword" alignment="CENTER_LEFT" spacing="8.0" styleClass="campo-caja">
                     <children>
                        <StackPane alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                           <children>
                              <PasswordField fx:id="txtPasswordOculto" onAction="#registrar" promptText="Mínimo 8 caracteres" styleClass="campo-input" />
                              <TextField fx:id="txtPasswordVisible" managed="false" onAction="#registrar" promptText="Mínimo 8 caracteres" styleClass="campo-input" visible="false" />
                           </children>
                        </StackPane>
                        <StackPane onMouseClicked="#alternarPassword" styleClass="icono-boton">
                           <children>
                              <Group>
                                 <children>
                                    <SVGPath fx:id="iconoOjo" content="M2 12 C2 12 5.5 5 12 5 C18.5 5 22 12 22 12 C22 12 18.5 19 12 19 C5.5 19 2 12 2 12 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z" scaleX="0.75" scaleY="0.75" styleClass="icono" />
                                 </children>
                              </Group>
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Medidor: el controlador rellena los cuatro tramos y cambia el texto -->
            <VBox spacing="6.0">
               <children>
                  <HBox spacing="6.0">
                     <children>
                        <Region fx:id="tramo1" maxWidth="1.7976931348623157E308" styleClass="tramo" HBox.hgrow="ALWAYS" />
                        <Region fx:id="tramo2" maxWidth="1.7976931348623157E308" styleClass="tramo" HBox.hgrow="ALWAYS" />
                        <Region fx:id="tramo3" maxWidth="1.7976931348623157E308" styleClass="tramo" HBox.hgrow="ALWAYS" />
                        <Region fx:id="tramo4" maxWidth="1.7976931348623157E308" styleClass="tramo" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <Label fx:id="lblMedidor" styleClass="medidor-texto" text="Mínimo 8 caracteres, con letras y números." />
               </children>
            </VBox>
         </children>
      </VBox>

      <VBox spacing="3.0">
         <children>
            <FlowPane alignment="CENTER_LEFT" hgap="4.0" vgap="2.0">
               <children>
                  <CheckBox fx:id="chkTerminos" mnemonicParsing="false" text="Acepto las" />
                  <Hyperlink onAction="#verCondiciones" styleClass="enlace" text="condiciones de uso" />
                  <Label styleClass="texto-formulario" text="y la" />
                  <Hyperlink onAction="#verPrivacidad" styleClass="enlace" text="política de privacidad" />
               </children>
            </FlowPane>
            <Label styleClass="texto-suave-pequeno" text="No compartimos tus datos con terceros." />
         </children>
      </VBox>

      <Label fx:id="lblError" managed="false" styleClass="mensaje-error" visible="false" wrapText="true" />

      <Button fx:id="btnCrear" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrar" styleClass="boton-primario" text="Crear mi cuenta" />

      <HBox alignment="CENTER" spacing="5.0">
         <children>
            <Label styleClass="texto-suave" text="¿Ya tienes cuenta?" />
            <Hyperlink onAction="#irALogin" styleClass="enlace" text="Iniciar sesión" />
         </children>
      </HBox>
   </children>
</VBox>
