<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.SVGPath?>

<!-- Pantalla de acceso: cabecera + hueco central donde se intercambian los paneles de login y registro -->

<BorderPane prefHeight="680.0" prefWidth="1000.0" styleClass="auth-raiz" stylesheets="@styles/application.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AuthController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="cabecera">
         <children>
            <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="logo" HBox.hgrow="NEVER">
               <children>
                  <Group>
                     <children>
                        <SVGPath content="m 0 0 L 8 0 C 24 0 24 -44 8 -44 L 0 -44 C -18 -44 -17 0 0 0 M 0 -4 C 12 -4 12 -40 0 -40 C -12 -40 -12 -4 0 -4 M -3 -32 L 4 -32 L 4 -12 L -3 -12 L -3 -32 M 4 -32 L -2 -32 L -2 -13 L 4 -13 L 4 -32 M 0 -44 C 17 -44 17 0 0 0" scaleX="0.8333" scaleY="0.8333" styleClass="icono" />
                     </children>
                  </Group>
               </children>
            </StackPane>
            <Label styleClass="cabecera-titulo" text="MisCuentas" />
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="auth-scroll">
         <content>
            <StackPane alignment="CENTER">
               <children>
                  <StackPane maxWidth="400.0" minWidth="300.0">
                     <padding>
                        <Insets bottom="32.0" left="24.0" right="24.0" top="32.0" />
                     </padding>
                     <children>
                        <fx:include fx:id="login" source="panels/LoginPanel.fxml" />
                        <fx:include fx:id="registro" source="panels/RegistroPanel.fxml" />
                        <fx:include fx:id="recuperar" source="panels/RecuperarPanel.fxml" />
                     </children>
                  </StackPane>
               </children>
            </StackPane>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
