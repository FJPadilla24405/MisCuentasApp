<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Ventana para cambiar la contraseña (la abre la pantalla de perfil) -->
<VBox prefWidth="440.0" spacing="16.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CambiarContrasenaController">
   <padding>
      <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
   </padding>
   <children>
      <Label styleClass="panel-titulo" text="Cambiar contraseña" />
      <Label fx:id="lblNota" styleClass="texto-formulario" text="Escribe tu contraseña actual y la nueva." wrapText="true" />

      <VBox spacing="6.0">
         <children>
            <Label styleClass="campo-etiqueta" text="Contraseña actual" />
            <HBox fx:id="cajaActual" alignment="CENTER_LEFT" spacing="8.0" styleClass="campo-caja">
               <children>
                  <PasswordField fx:id="txtActual" onAction="#cambiar" promptText="Tu contraseña actual" styleClass="campo-input" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox spacing="8.0">
         <children>
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="campo-etiqueta" text="Contraseña nueva" />
                  <HBox fx:id="cajaNueva" alignment="CENTER_LEFT" spacing="8.0" styleClass="campo-caja">
                     <children>
                        <StackPane alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                           <children>
                              <PasswordField fx:id="txtNuevaOculta" onAction="#cambiar" promptText="Mínimo 8 caracteres" styleClass="campo-input" />
                              <TextField fx:id="txtNuevaVisible" managed="false" onAction="#cambiar" promptText="Mínimo 8 caracteres" styleClass="campo-input" visible="false" />
                           </children>
                        </StackPane>
                        <StackPane onMouseClicked="#alternarNueva" styleClass="icono-boton">
                           <children>
                              <Group>
                                 <children>
                                    <SVGPath fx:id="iconoOjo" content="M2 12 C2 12 5.5 5 12 5 C18.5 5 22 12 22 12 C22 12 18.5 19 12 19 C5.5 19 2 12 2 12 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z" scaleX="0.75" scaleY="0.75" styleClass="icono" />
                                 </children>
                              </Group>
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="6.0">
               <children>
                  <HBox spacing="6.0">
                     <children>
                        <Region fx:id="tramo1" maxWidth="1.7976931348623157E308" styleClass="tramo" HBox.hgrow="ALWAYS" />
                        <Region fx:id="tramo2" maxWidth="1.7976931348623157E308" styleClass="tramo" HBox.hgrow="ALWAYS" />
                        <Region fx:id="tramo3" maxWidth="1.7976931348623157E308" styleClass="tramo" HBox.hgrow="ALWAYS" />
                        <Region fx:id="tramo4" maxWidth="1.7976931348623157E308" styleClass="tramo" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <Label fx:id="lblMedidor" styleClass="medidor-texto" text="Mínimo 8 caracteres, con letras y números." />
               </children>
            </VBox>
         </children>
      </VBox>

      <VBox spacing="6.0">
         <children>
            <Label styleClass="campo-etiqueta" text="Repite la contraseña nueva" />
            <HBox fx:id="cajaRepetir" alignment="CENTER_LEFT" spacing="8.0" styleClass="campo-caja">
               <children>
                  <PasswordField fx:id="txtRepetir" onAction="#cambiar" promptText="Repite la contraseña nueva" styleClass="campo-input" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>

      <Label fx:id="lblError" managed="false" styleClass="mensaje-error" visible="false" wrapText="true" />

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button cancelButton="true" mnemonicParsing="false" onAction="#cancelar" prefWidth="120.0" styleClass="boton-secundario" text="Cancelar" />
            <Button fx:id="btnCambiar" defaultButton="true" mnemonicParsing="false" onAction="#cambiar" prefWidth="170.0" styleClass="boton-primario" text="Cambiar contraseña" />
         </children>
      </HBox>
   </children>
</VBox>
