<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Ventana para crear un presupuesto (la abre la pantalla de presupuestos) -->
<VBox prefWidth="540.0" spacing="16.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.NuevoPresupuestoController">
   <padding>
      <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
   </padding>
   <fx:define>
      <ToggleGroup fx:id="grupoAlcance" />
   </fx:define>
   <children>
      <!-- Título y pastilla de borrador -->
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label styleClass="tarjeta-titulo" text="Datos del presupuesto" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="pastilla-borrador" text="Borrador sin guardar" />
         </children>
      </HBox>

      <!-- Nombre -->
      <VBox spacing="6.0">
         <children>
            <Label styleClass="campo-etiqueta" text="Nombre *" />
            <HBox fx:id="cajaNombre" alignment="CENTER_LEFT" spacing="8.0" styleClass="campo-caja">
               <children>
                  <TextField fx:id="txtNombre" onAction="#guardar" promptText="Por ejemplo: Alimentación del mes" styleClass="campo-input" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Categoría -->
      <VBox spacing="6.0">
         <children>
            <Label styleClass="campo-etiqueta" text="Categoría *" />
            <ComboBox fx:id="cmbCategoria" maxWidth="1.7976931348623157E308" promptText="Elige una categoría" styleClass="combo-campo" />
         </children>
      </VBox>

      <!-- Importe límite -->
      <VBox spacing="6.0">
         <children>
            <Label styleClass="campo-etiqueta" text="Importe límite *" />
            <HBox fx:id="cajaImporte" alignment="CENTER_LEFT" spacing="8.0" styleClass="campo-importe">
               <children>
                  <TextField fx:id="txtImporte" onAction="#guardar" promptText="0,00" styleClass="campo-input, campo-importe-input" HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblMoneda" styleClass="campo-importe-moneda" text="EUR €" />
               </children>
            </HBox>
            <Label styleClass="texto-suave-pequeno" text="Es tu límite de gasto para la categoría y el periodo elegidos." />
         </children>
      </VBox>

      <!-- Mes y año -->
      <VBox spacing="6.0">
         <children>
            <HBox spacing="12.0">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-etiqueta" text="Mes *" />
                        <ComboBox fx:id="cmbMes" maxWidth="1.7976931348623157E308" styleClass="combo-campo" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="campo-etiqueta" text="Año *" />
                        <ComboBox fx:id="cmbAnio" maxWidth="1.7976931348623157E308" styleClass="combo-campo" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Label fx:id="lblPeriodo" styleClass="texto-suave-pequeno" />
         </children>
      </VBox>

      <!-- Alcance de cuentas -->
      <VBox spacing="6.0">
         <children>
            <Label styleClass="campo-etiqueta" text="Alcance de cuentas *" />
            <HBox spacing="10.0">
               <children>
                  <ToggleButton fx:id="tglTodas" maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="true" styleClass="opcion-alcance" text="Todas" toggleGroup="$grupoAlcance" HBox.hgrow="ALWAYS">
                     <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Region styleClass="radio-punto" />
                              <Group>
                                 <children>
                                    <SVGPath content="M4 7 H19 A1 1 0 0 1 20 8 V19 A1 1 0 0 1 19 20 H5 A2 2 0 0 1 3 18 V6 A2 2 0 0 1 5 4 H17 M16 14 L16.01 14" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                                 </children>
                              </Group>
                           </children>
                        </HBox>
                     </graphic>
                  </ToggleButton>
                  <ToggleButton fx:id="tglBanco" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="opcion-alcance" text="Banco" toggleGroup="$grupoAlcance" HBox.hgrow="ALWAYS">
                     <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Region styleClass="radio-punto" />
                              <Group>
                                 <children>
                                    <SVGPath content="M3 21 H21 M5 21 V11 M9 21 V11 M15 21 V11 M19 21 V11 M12 3 L3 9 H21 Z" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                                 </children>
                              </Group>
                           </children>
                        </HBox>
                     </graphic>
                  </ToggleButton>
                  <ToggleButton fx:id="tglEfectivo" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="opcion-alcance" text="Efectivo" toggleGroup="$grupoAlcance" HBox.hgrow="ALWAYS">
                     <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Region styleClass="radio-punto" />
                              <Group>
                                 <children>
                                    <SVGPath content="M3 6 H21 V18 H3 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                                 </children>
                              </Group>
                           </children>
                        </HBox>
                     </graphic>
                  </ToggleButton>
               </children>
            </HBox>
            <Label fx:id="lblAlcance" styleClass="texto-suave-pequeno" wrapText="true" />
         </children>
      </VBox>

      <Label fx:id="lblError" managed="false" styleClass="mensaje-error" visible="false" wrapText="true" />

      <!-- Pie: aviso de campos obligatorios y botones -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label styleClass="texto-suave-pequeno" text="* Campos obligatorios" />
            <Region HBox.hgrow="ALWAYS" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#cancelar" prefWidth="110.0" styleClass="boton-secundario" text="Cancelar" />
            <Button defaultButton="true" mnemonicParsing="false" onAction="#guardar" prefWidth="170.0" styleClass="boton-primario" text="Guardar presupuesto" />
         </children>
      </HBox>
   </children>
</VBox>
