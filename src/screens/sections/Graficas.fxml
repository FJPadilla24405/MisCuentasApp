<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!-- Pantalla de gráficas y resúmenes. Tiene dos vistas (mensual y anual) que comparten esta misma pantalla: GraficasController
     cambia los textos y los datos. Las gráficas (barras, anillo y línea) y las filas de las tablas las crea el controlador -->
<ScrollPane fx:id="raiz" fitToWidth="true" hbarPolicy="NEVER" styleClass="resumen-scroll" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GraficasController">
   <content>
      <VBox spacing="20.0" styleClass="resumen-contenido">
         <children>

            <!-- Cabecera: título y exportar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblEtiqueta" managed="false" styleClass="resumen-etiqueta" text="GRÁFICAS Y RESÚMENES" visible="false" />
                        <Label fx:id="lblTitulo" styleClass="resumen-titulo" text="Entenderlo es el primer paso." wrapText="true" />
                        <Label fx:id="lblSubtitulo" managed="false" styleClass="texto-suave" text="Cada mes cuenta." visible="false" wrapText="true" />
                     </children>
                  </VBox>
                  <Button mnemonicParsing="false" onAction="#exportar" styleClass="boton-primario, boton-primario-icono" text="Exportar resumen">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M12 4 V15 M7 11 L12 16 L17 11 M5 20 H19" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                           </children>
                        </Group>
                     </graphic>
                  </Button>
               </children>
            </HBox>

            <!-- Filtros: cuenta, mes o año, y periodo -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <MenuButton fx:id="menuCuenta" mnemonicParsing="false" styleClass="boton-filtro" text="Todas las cuentas">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M3 21 H21 M5 21 V11 M9 21 V11 M15 21 V11 M19 21 V11 M12 3 L3 9 H21 Z" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                           </children>
                        </Group>
                     </graphic>
                  </MenuButton>
                  <HBox alignment="CENTER" styleClass="vista-segmentada">
                     <children>
                        <ToggleButton fx:id="tglMes" mnemonicParsing="false" selected="true" styleClass="vista-opcion" text="Mes" />
                        <ToggleButton fx:id="tglAnio" mnemonicParsing="false" styleClass="vista-opcion" text="Año" />
                     </children>
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnAnterior" mnemonicParsing="false" onAction="#periodoAnterior" styleClass="boton-filtro, boton-flecha">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M15 6 L9 12 L15 18" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                           </children>
                        </Group>
                     </graphic>
                  </Button>
                  <MenuButton fx:id="menuPeriodo" mnemonicParsing="false" styleClass="boton-filtro" text="Septiembre 2026">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M5 5 H19 A2 2 0 0 1 21 7 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V7 A2 2 0 0 1 5 5 Z M3 10 H21 M8 3 V7 M16 3 V7" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                           </children>
                        </Group>
                     </graphic>
                  </MenuButton>
                  <Button fx:id="btnSiguiente" mnemonicParsing="false" onAction="#periodoSiguiente" styleClass="boton-filtro, boton-flecha">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M9 6 L15 12 L9 18" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                           </children>
                        </Group>
                     </graphic>
                  </Button>
               </children>
            </HBox>

            <!-- Tarjetas de resumen: ingresos, gastos, balance y tasa de ahorro -->
            <GridPane hgap="16.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
               </columnConstraints>
               <children>
                  <VBox spacing="8.0" styleClass="kpi" GridPane.columnIndex="0">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label fx:id="lblIngresosTitulo" styleClass="kpi-titulo" text="Ingresos" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Group>
                                 <children>
                                    <SVGPath content="M17 7 L7 17 M17 17 H7 V7" scaleX="0.67" scaleY="0.67" styleClass="icono, icono-ingreso" />
                                 </children>
                              </Group>
                           </children>
                        </HBox>
                        <Label fx:id="lblIngresos" styleClass="kpi-valor" text="0,00 €" />
                        <Label fx:id="lblIngresosDetalle" styleClass="kpi-detalle" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0" styleClass="kpi" GridPane.columnIndex="1">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label fx:id="lblGastosTitulo" styleClass="kpi-titulo" text="Gastos" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Group>
                                 <children>
                                    <SVGPath content="M7 17 L17 7 M7 7 H17 V17" scaleX="0.67" scaleY="0.67" styleClass="icono, icono-gasto" />
                                 </children>
                              </Group>
                           </children>
                        </HBox>
                        <Label fx:id="lblGastos" styleClass="kpi-valor" text="0,00 €" />
                        <Label fx:id="lblGastosDetalle" styleClass="kpi-detalle" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0" styleClass="kpi, kpi-principal" GridPane.columnIndex="2">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label fx:id="lblBalanceTitulo" styleClass="kpi-titulo" text="Balance neto" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Group>
                                 <children>
                                    <SVGPath content="M12 21 V11 M12 12 C12 8 9 6 5 6 C5 10 8 12 12 12 Z M12 14 C12 11 14.5 9 18 9 C18 12.5 15.5 14 12 14 Z" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                                 </children>
                              </Group>
                           </children>
                        </HBox>
                        <Label fx:id="lblBalance" styleClass="kpi-valor" text="0,00 €" />
                        <Label fx:id="lblBalanceDetalle" styleClass="kpi-detalle" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0" styleClass="kpi" GridPane.columnIndex="3">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="kpi-titulo" text="Tasa de ahorro" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Group>
                                 <children>
                                    <SVGPath content="M3 17 L9 11 L13 15 L21 7 M15 7 H21 V13" scaleX="0.67" scaleY="0.67" styleClass="icono, icono-ingreso" />
                                 </children>
                              </Group>
                           </children>
                        </HBox>
                        <Label fx:id="lblTasa" styleClass="kpi-valor" text="—" />
                        <Label fx:id="lblTasaDetalle" styleClass="kpi-detalle" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </GridPane>

            <!-- Gráficas: a la izquierda ingresos y gastos; a la derecha, según la vista, el reparto del gasto o el balance acumulado -->
            <GridPane fx:id="gridGraficos" hgap="16.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="57.0" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="43.0" />
               </columnConstraints>
               <children>

                  <!-- Ingresos y gastos (por semana o por mes) -->
                  <VBox spacing="12.0" styleClass="tarjeta, grafico-tarjeta" GridPane.columnIndex="0">
                     <children>
                        <HBox alignment="TOP_LEFT" spacing="10.0">
                           <children>
                              <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="tarjeta-titulo" text="Ingresos y gastos" />
                                    <Label fx:id="lblBarrasSubtitulo" styleClass="texto-suave-pequeno" />
                                 </children>
                              </VBox>
                              <HBox alignment="CENTER_RIGHT" spacing="14.0">
                                 <children>
                                    <HBox alignment="CENTER" spacing="6.0">
                                       <children>
                                          <Circle fill="#287a57" radius="4.0" />
                                          <Label styleClass="texto-suave-pequeno" text="Ingresos" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER" spacing="6.0">
                                       <children>
                                          <Circle fill="#a9c7b3" radius="4.0" />
                                          <Label styleClass="texto-suave-pequeno" text="Gastos" />
                                       </children>
                                    </HBox>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        <StackPane fx:id="huecoBarras" minHeight="200.0" prefHeight="240.0" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>

                  <!-- Vista mensual: en qué se va el dinero -->
                  <VBox fx:id="tarjetaCategorias" spacing="14.0" styleClass="tarjeta, grafico-tarjeta" GridPane.columnIndex="1">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="tarjeta-titulo" text="¿En qué se va tu dinero?" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblCategoriasMes" styleClass="texto-suave-pequeno" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="18.0" VBox.vgrow="ALWAYS">
                           <children>
                              <StackPane fx:id="huecoDonut" maxHeight="150.0" maxWidth="150.0" minHeight="130.0" minWidth="130.0" prefHeight="150.0" prefWidth="150.0" />
                              <VBox fx:id="listaCategorias" alignment="CENTER_LEFT" spacing="9.0" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <HBox fx:id="notaCategoria" alignment="CENTER_LEFT" spacing="8.0" styleClass="nota-insight">
                           <children>
                              <StackPane fx:id="notaIcono" />
                              <Label fx:id="lblNotaCategoria" styleClass="texto-suave" wrapText="true" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Vista anual: balance acumulado -->
                  <VBox fx:id="tarjetaAcumulado" managed="false" spacing="4.0" styleClass="tarjeta, grafico-tarjeta" visible="false" GridPane.columnIndex="1">
                     <children>
                        <Label styleClass="tarjeta-titulo" text="El esfuerzo que suma." />
                        <Label fx:id="lblAcumuladoValor" styleClass="kpi-valor" text="0,00 €" />
                        <Label fx:id="lblAcumuladoDetalle" styleClass="texto-suave-pequeno" wrapText="true" />
                        <StackPane fx:id="huecoLinea" minHeight="110.0" prefHeight="150.0" VBox.vgrow="ALWAYS" />
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label fx:id="lblConservado" managed="false" styleClass="pastilla" visible="false" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </GridPane>

            <!-- Tabla: cuenta por cuenta (mensual) o mes a mes (anual). Las filas las crea GraficasController -->
            <VBox styleClass="tarjeta">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="tarjeta-cabecera">
                     <children>
                        <Label fx:id="lblTablaTitulo" styleClass="tarjeta-titulo" text="El mes, cuenta por cuenta" />
                        <Label fx:id="lblTablaPastilla" styleClass="pastilla" text="0 movimientos" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="cajaMejorMes" alignment="CENTER" managed="false" spacing="6.0" styleClass="pastilla-destacada" visible="false">
                           <children>
                              <Group>
                                 <children>
                                    <SVGPath content="M12 21 V11 M12 12 C12 8 9 6 5 6 C5 10 8 12 12 12 Z M12 14 C12 11 14.5 9 18 9 C18 12.5 15.5 14 12 14 Z" scaleX="0.6" scaleY="0.6" styleClass="icono" />
                                 </children>
                              </Group>
                              <Label fx:id="lblMejorMes" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <VBox fx:id="listaTabla" />
                  <Label fx:id="lblVacio" managed="false" styleClass="tabla-vacia" visible="false" wrapText="true" />
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
