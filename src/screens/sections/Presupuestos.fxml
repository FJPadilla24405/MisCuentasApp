<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Pantalla de presupuestos del mes: límite total, gastado, restante y una tarjeta por categoría. Las tarjetas las crea PresupuestosController -->
<ScrollPane fx:id="raiz" fitToWidth="true" hbarPolicy="NEVER" styleClass="resumen-scroll" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PresupuestosController">
   <content>
      <VBox spacing="20.0" styleClass="resumen-contenido">
         <children>

            <!-- Cabecera: título, selector de mes y botón de añadir -->
            <HBox alignment="TOP_LEFT" spacing="12.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="resumen-etiqueta" text="PRESUPUESTOS" />
                        <Label styleClass="resumen-titulo" text="Ver presupuestos" wrapText="true" />
                        <Label styleClass="texto-suave" text="Pon límites a tus gastos y haz espacio para lo que importa." wrapText="true" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <MenuButton fx:id="menuMes" mnemonicParsing="false" styleClass="boton-filtro" text="Mes">
                           <graphic>
                              <Group>
                                 <children>
                                    <SVGPath content="M5 5 H19 A2 2 0 0 1 21 7 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V7 A2 2 0 0 1 5 5 Z M3 10 H21 M8 3 V7 M16 3 V7" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                                 </children>
                              </Group>
                           </graphic>
                        </MenuButton>
                        <Button mnemonicParsing="false" onAction="#anadirPresupuesto" styleClass="boton-primario, boton-anadir" text="Añadir presupuesto">
                           <graphic>
                              <Group>
                                 <children>
                                    <SVGPath content="M12 5 V19 M5 12 H19" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                                 </children>
                              </Group>
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- Tarjetas de resumen: límite total, gastado y restante -->
            <GridPane hgap="16.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="33.333" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="33.333" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="33.334" />
               </columnConstraints>
               <children>
                  <VBox spacing="8.0" styleClass="kpi, kpi-principal" GridPane.columnIndex="0">
                     <children>
                        <Label styleClass="kpi-titulo" text="Límite total del mes" />
                        <Label fx:id="lblLimiteTotal" styleClass="kpi-valor" text="0,00 €" />
                        <Label fx:id="lblLimiteDetalle" styleClass="kpi-detalle" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0" styleClass="kpi" GridPane.columnIndex="1">
                     <children>
                        <Label fx:id="lblGastadoTitulo" styleClass="kpi-titulo" text="Gastado en el mes" />
                        <Label fx:id="lblGastado" styleClass="kpi-valor" text="0,00 €" />
                        <Label fx:id="lblGastadoDetalle" styleClass="kpi-detalle" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0" styleClass="kpi" GridPane.columnIndex="2">
                     <children>
                        <Label styleClass="kpi-titulo" text="Restante del presupuesto" />
                        <Label fx:id="lblRestante" styleClass="kpi-valor" text="0,00 €" />
                        <Label fx:id="lblRestanteDetalle" styleClass="kpi-detalle" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </GridPane>

            <!-- Aviso: presupuestos cerca del límite o superados (se oculta si no hay ninguno) -->
            <HBox fx:id="cajaAviso" alignment="CENTER_LEFT" managed="false" spacing="10.0" styleClass="aviso-presupuesto" visible="false">
               <children>
                  <Group>
                     <children>
                        <SVGPath content="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 8 V13 M12 16 L12.01 16" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                     </children>
                  </Group>
                  <Label fx:id="lblAviso" styleClass="aviso-texto" wrapText="true" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <!-- Título de la lista de categorías -->
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="tarjeta-titulo" text="Tus presupuestos por categoría" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblPeriodo" styleClass="texto-suave" text="Mensuales" />
               </children>
            </HBox>

            <!-- Una tarjeta por presupuesto. Las crea PresupuestosController -->
            <GridPane fx:id="gridPresupuestos" hgap="16.0" vgap="16.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="33.333" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="33.333" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="33.334" />
               </columnConstraints>
            </GridPane>
            <Label fx:id="lblVacio" managed="false" styleClass="texto-suave" visible="false" wrapText="true" />

            <!-- Pie -->
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="texto-suave-pequeno" text="Los límites te ayudan a planificar; no modifican tus movimientos ni tus saldos." />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblDatosHasta" styleClass="texto-suave-pequeno" />
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
