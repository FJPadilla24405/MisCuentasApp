<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Barra lateral de la aplicación. La lista "Tus cuentas" (listaCuentas) la rellena el controlador desde la base de datos -->
<VBox maxWidth="240.0" minWidth="240.0" prefWidth="240.0" styleClass="barra-lateral" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BarraLateralController">
   <children>
      <!-- Cabecera: logo y nombre -->
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="barra-cabecera">
         <children>
            <StackPane styleClass="logo-barra">
               <children>
                  <Group>
                     <children>
                        <SVGPath content="M12 21 V11 M12 12 C12 8 9 6 5 6 C5 10 8 12 12 12 Z M12 14 C12 11 14.5 9 18 9 C18 12.5 15.5 14 12 14 Z" scaleX="0.9" scaleY="0.9" styleClass="icono" />
                     </children>
                  </Group>
               </children>
            </StackPane>
            <Label styleClass="barra-titulo" text="MisCuentas" />
         </children>
      </HBox>

      <!-- Zona con scroll: apartados y cuentas -->
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="barra-scroll" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="2.0" styleClass="barra-contenido">
               <children>
                  <Label styleClass="barra-seccion" text="TU DÍA A DÍA" />
                  <Button fx:id="btnVistaGeneral" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irAVistaGeneral" styleClass="nav-item" text="Vista general">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                           </children>
                        </Group>
                     </graphic>
                  </Button>
                  <Button fx:id="btnGraficas" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irAGraficas" styleClass="nav-item" text="Gráficas y resúmenes">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M4 4 V20 H20 M8 16 V12 M12 16 V8 M16 16 V10" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                           </children>
                        </Group>
                     </graphic>
                  </Button>
                  <Button fx:id="btnPresupuestos" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irAPresupuestos" styleClass="nav-item" text="Presupuestos">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M12 3 A9 9 0 1 0 21 12 H12 Z M15 3.6 A9 9 0 0 1 20.4 9 H15 Z" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                           </children>
                        </Group>
                     </graphic>
                  </Button>

                  <Label styleClass="barra-seccion" text="TUS CUENTAS" />
                  <!-- Una fila por cuenta, creada desde BarraLateralController. Vacía mientras no haya cuentas -->
                  <VBox fx:id="listaCuentas" spacing="2.0" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#anadirCuenta" styleClass="nav-item" text="Añadir cuenta">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M12 5 V19 M5 12 H19" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                           </children>
                        </Group>
                     </graphic>
                  </Button>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <!-- Pie: perfil y usuario -->
      <VBox spacing="6.0" styleClass="barra-pie">
         <children>
            <Button fx:id="btnPerfil" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irAPerfil" styleClass="nav-item" text="Editar perfil">
               <graphic>
                  <Group>
                     <children>
                        <SVGPath content="M20 21 V19 A4 4 0 0 0 16 15 H8 A4 4 0 0 0 4 19 V21 M12 3 A4 4 0 1 0 12 11 A4 4 0 1 0 12 3 Z" scaleX="0.67" scaleY="0.67" styleClass="icono" />
                     </children>
                  </Group>
               </graphic>
            </Button>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="barra-usuario">
               <children>
                  <StackPane styleClass="avatar">
                     <children>
                        <Label fx:id="lblIniciales" styleClass="avatar-texto" text="LM" />
                     </children>
                  </StackPane>
                  <VBox alignment="CENTER_LEFT" spacing="1.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblNombre" maxWidth="1.7976931348623157E308" styleClass="usuario-nombre" text="Nombre" />
                        <Label styleClass="usuario-detalle" text="Cuenta personal" />
                     </children>
                  </VBox>
                  <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="boton-icono">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M9 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 H9 M16 17 L21 12 L16 7 M21 12 H9" scaleX="0.75" scaleY="0.75" styleClass="icono" />
                           </children>
                        </Group>
                     </graphic>
                     <tooltip>
                        <Tooltip text="Cerrar sesión" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
